		],
		groups: [],
		classes: [],
	}),
)

## unsupported-click
expect OracleFlowchart.agrees(
	"flowchart TD\n    A --> B\n    click A \"https://example.com\"\n",
	Unsupported,
)

## unsupported-html-label
expect OracleFlowchart.agrees(
	"flowchart TD\n    A[<b>bold</b>]\n",
	Unsupported,
)

## unsupported-markdown
