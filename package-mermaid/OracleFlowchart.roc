import Flowchart

## Generated by tools/mermaid-oracle/golden.mjs. Do not edit; re-record the
## oracle and regenerate instead.
##
## Each expectation states what Mermaid did with one source text, so a
## failure here is a disagreement with Mermaid.
OracleFlowchart :: {}.{
	Expected : [Accepted(Flowchart.Diagram), Rejected, Unsupported]

	agrees : Str, Expected -> Bool
	agrees = |source, expected|
		match (Flowchart.parse(source), expected) {
			(Ok(found), Accepted(wanted)) => found == wanted
			(Err(problems), Rejected) => !problems.any(OracleFlowchart.is_unsupported)
			(Err(problems), Unsupported) => problems.any(OracleFlowchart.is_unsupported)
			_ => False
		}

	is_unsupported : Flowchart.Problem -> Bool
	is_unsupported = |problem|
		match problem {
			Unsupported(_) => True
			_ => False
		}
}

