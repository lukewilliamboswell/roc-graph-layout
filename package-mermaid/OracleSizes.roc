import Flowchart
import FlowGeometry
import FlowSize

## Generated by tools/mermaid-oracle/golden_sizes.mjs. Do not edit; re-record the
## oracle and regenerate instead.
##
## Each expectation states the sizes Mermaid measured for one recorded case:
## node shape boxes, and each label's line breaks and text box. A failure here
## is a disagreement with Mermaid's measurements.
OracleSizes :: {}.{
	ExpectedText : [Text({ lines : List(Str), width : F64, height : F64, height_tolerance : F64 }), Skip]

	Expected : {
		nodes : List([Node({ width : F64, height : F64, tolerance : F64, label : ExpectedText }), Skip]),
		edge_labels : List([NoLabel, Skip, Text({ lines : List(Str), width : F64, height : F64, height_tolerance : F64 })]),
		group_titles : List(ExpectedText),
	}

	agrees : Str, Expected -> Bool
	agrees = |source, expected|
		match Flowchart.parse(source) {
			Err(_) => False
			Ok(diagram) => {
				sizes = FlowSize.sizes(diagram, FlowSize.mermaid)
				nodes_agree = sizes.nodes.len() == expected.nodes.len()
					and List.map2(sizes.nodes, expected.nodes, |found, wanted| OracleSizes.node_agrees(found, wanted)).all(|ok| ok)
				edges_agree = sizes.edge_labels.len() == expected.edge_labels.len()
					and List.map2(sizes.edge_labels, expected.edge_labels, |found, wanted| OracleSizes.edge_agrees(found, wanted)).all(|ok| ok)
				groups_agree = sizes.group_titles.len() == expected.group_titles.len()
					and List.map2(sizes.group_titles, expected.group_titles, |found, wanted| OracleSizes.text_agrees(found, wanted)).all(|ok| ok)
				nodes_agree and edges_agree and groups_agree
			}
		}

	close : F64, F64, F64 -> Bool
	close = |a, b, tolerance| F64.abs(a - b) <= tolerance

	node_agrees : { width : F64, height : F64, label : FlowGeometry.TextBlock }, [Node({ width : F64, height : F64, tolerance : F64, label : ExpectedText }), Skip] -> Bool
	node_agrees = |found, wanted|
		match wanted {
			Skip => True
			Node(n) =>
				OracleSizes.close(found.width, n.width, n.tolerance)
					and OracleSizes.close(found.height, n.height, n.tolerance)
					and OracleSizes.text_agrees(found.label, n.label)
		}

	text_agrees : FlowGeometry.TextBlock, ExpectedText -> Bool
	text_agrees = |found, wanted|
		match wanted {
			Skip => True
			Text(t) => found.lines == t.lines and OracleSizes.close(found.width, t.width, 0.01) and OracleSizes.close(found.height, t.height, t.height_tolerance)
		}

	edge_agrees : [None, Some(FlowGeometry.TextBlock)], [NoLabel, Skip, Text({ lines : List(Str), width : F64, height : F64, height_tolerance : F64 })] -> Bool
	edge_agrees = |found, wanted|
		match (found, wanted) {
			(_, Skip) => True
			(None, NoLabel) => True
			(Some(block), Text(t)) => OracleSizes.text_agrees(block, Text(t))
			_ => False
		}
}

