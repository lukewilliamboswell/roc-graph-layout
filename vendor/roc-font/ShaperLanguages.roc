	multi : List(U8)
	multi = "acf FAN CPP     acr ACR MYN     acy ACY ARA     aii SWA SYR     akb AKB BTK     ary MOR ARA     azb AZB AZE     bbc BBC BTK     bgq BGQ RAJ     blk BLK KRN     btd BTD BTK     btm BTM BTK     bts BTS BTK     btx BTX BTK     btz BTZ BTK     byv BYV BML     caf CRR ATH     cak CAK MYN     cbk CBK CPP     cfm HAL QIN     chm HMA LMA     chp CHP SAY ATH cqu QUH QUZ     crj ECR YCR CRE crk WCR YCR CRE crl ECR YCR CRE crm MCR LCR CRE crx CRR ATH     csw NCR NHC CRE cwd DCR TCR CRE den SLA ATH     dgo DGO DGR     diq DIQ ZZA     drw DRI FAR     emk EMK MNK     fan FAN0BTI     fat FAT AKA     flm HAL QIN     fmp FMP BML     fuf FTA FUL     fuv FUV FUL     gkp GKP KPL     hmd HMD HMN     hmz HMZ HMN     hoj HAR RAJ     ike INU INUK    jam JAM CPP     kab KAB0BBR     kca KHK KHS KHV kea KEA CPP     kek KEK MYN     kht KHT KHN     kiu KIU ZZA     kjp KJP KRN     koi KOP KOM     kpv KOZ KOM     krc KAR BAL     kri KRI CPP     ksw KSW KRN     kvq KVQ KRN     kyu KYU KRN     lus MIZ QIN     mam MAM MYN     max MLY CPP     mfa MFA MLY     mfe MFE CPP     min MIN MLY     mlq MLN MNK     mnk MND MNK     mnw MON MONT    msi MLY CPP     mww MWW HMN     nag NAG CPP     ojs OCR OJB     pap PAP0CPP     pga ARA CPP     pih PIH CPP     poh POH MYN     prs DRI FAR     pwo PWO KRN     qub QWH QUZ     quc QUC MYN     qud QVI QUZ     qug QVI QUZ     quh QUH QUZ     qul QUH QUZ     qup QVI QUZ     qur QWH QUZ     qus QUH QUZ     quw QVI QUZ     qux QWH QUZ     qva QWH QUZ     qvh QWH QUZ     qvi QVI QUZ     qvj QVI QUZ     qvl QWH QUZ     qvm QWH QUZ     qvn QWH QUZ     qvo QVI QUZ     qvp QWH QUZ     qvw QWH QUZ     qvz QVI QUZ     qwa QWH QUZ     qwh QWH QUZ     qws QWH QUZ     qxa QWH QUZ     qxc QWH QUZ     qxh QWH QUZ     qxl QVI QUZ     qxn QWH QUZ     qxo QWH QUZ     qxr QVI QUZ     qxt QWH QUZ     qxw QWH QUZ     rif RIF BBR     rmy RMY ROY     scs SCS SLA ATH sfm SFM HMN     shi SHI BBR     taq TAQ TMH BBR thv THV TMH BBR thz THZ TMH BBR tmh TMH BBR     tnf DRI FAR     tpi TP